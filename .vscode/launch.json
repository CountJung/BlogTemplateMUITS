{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Full Stack",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "cwd": "${workspaceFolder}",
      "args": ["dev", "--hostname", "127.0.0.1", "--port", "65002"],
      "console": "internalConsole",
      "outputCapture": "std",
      "autoAttachChildProcesses": true,
      "serverReadyAction": {
        "pattern": "Ready in ",
        "uriFormat": "http://localhost:65002",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}",
        "killOnServerStop": true
      }
    },
    {
      "name": "Next.js: Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "cwd": "${workspaceFolder}",
      "args": ["dev", "--hostname", "127.0.0.1", "--port", "65002"],
      "console": "internalConsole",
      "autoAttachChildProcesses": true
    }
  ]
}
