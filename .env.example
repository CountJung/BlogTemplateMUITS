# NextAuth.js
NEXTAUTH_URL=http://localhost:65002
NEXTAUTH_SECRET=your-secret-key-here-please-change-this-to-a-secure-random-string

# Google OAuth
# Google Cloud Console에서 발급받은 클라이언트 정보를 입력하세요
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Permission Settings (권한 설정)
# 관리자 계정: 모든 권한 (읽기, 쓰기, 삭제)
ADMIN_EMAILS=admin@example.com

# 글쓰기 권한은 로그인 후 관리자 화면에서 부여합니다 (users.json).

# 일반 사용자: 로그인 후 읽기 권한만 (환경변수 설정 불필요, 기본값)

# Debug settings
NODE_ENV=development
